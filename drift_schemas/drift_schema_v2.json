  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NULL, \"priority\" INTEGER NOT NULL, \"due_date\" TEXT NULL, \"is_focused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_focused\" IN (0, 1)), \"focused_at\" INTEGER NULL, \"pinned_date\" TEXT NULL, \"not_before\" TEXT NULL, \"status\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, \"completed_on_plan\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed_on_plan\" IN (0, 1)), \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL DEFAULT 1 CHECK(\"id\" = 1), \"priority_scale\" INTEGER NOT NULL DEFAULT 5, \"weekly_capacity\" TEXT NOT NULL DEFAULT '[1,1,1,1,1,3,0]', \"max_overflow_per_day\" INTEGER NOT NULL DEFAULT 1, \"planning_horizon_days\" INTEGER NOT NULL DEFAULT 90, \"urgency_soon_days\" INTEGER NOT NULL DEFAULT 7, \"urgency_near_days\" INTEGER NOT NULL DEFAULT 2, \"focus_visible_limit\" INTEGER NOT NULL DEFAULT 3, \"day_start_hour\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "day_overrides",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"day_overrides\" (\"date\" TEXT NOT NULL, \"capacity\" INTEGER NOT NULL, \"note\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"date\"));"
        }
      ]
    },
